# --- Local development defaults (safe to keep as-is on your machine) ---
SECRET_KEY=dev-insecure-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=*

# --- Required for staging/production (DEBUG=False) ---
# SECRET_KEY must be a real, random secret (e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
# ALLOWED_HOSTS must list the real host(s), e.g. api.lingocheck.example.com
# CORS_ALLOWED_ORIGINS must list the real frontend origin(s), comma-separated
# CORS_ALLOWED_ORIGINS=https://lingocheck.example.com,https://app.lingocheck.example.com

# --- Database ---
# Leave unset to use local SQLite. Set to a real Postgres URL in staging/prod:
# DATABASE_URL=postgres://user:password@host:5432/lingocheck

# --- Auth throttling (requests per window, DRF ScopedRateThrottle syntax) ---
THROTTLE_RATE_LOGIN=10/min
THROTTLE_RATE_SIGNUP=10/min
THROTTLE_RATE_GUEST=20/min

# --- List pagination (admin users / question bank) ---
DEFAULT_PAGE_SIZE=50

# Adaptive placement-test engine
ASSESSMENT_BATCH_SIZE=5
ASSESSMENT_PASS_THRESHOLD_PERCENT=80

# --- Writing Assessment ---
# Self-hosted LanguageTool server (spelling/grammar).
# - Leave EMPTY for bare `manage.py runserver` local dev with no Docker:
#   an auto-managed local LanguageTool instance is started automatically
#   on first use (needs a local Java 17+ runtime; downloads ~200 MB the
#   very first time, cached afterwards - see apps/writing/README.md).
# - Set to a real URL (docker-compose.yml already does this for you,
#   pointing at the `languagetool` service) when running via Docker, or in
#   staging/production.
LANGUAGETOOL_SERVER_URL=
# Redis-backed Celery broker for async writing analysis (see the `redis`
# and `celery-worker` services in docker-compose.yml). Only used if
# WRITING_EAGER_MODE=0 below.
CELERY_BROKER_URL=redis://localhost:6379/0
# Local dev convenience ONLY: runs writing analysis synchronously in-process
# instead of via Celery, so you don't need Redis/a worker running locally.
# Recommended together with the empty LANGUAGETOOL_SERVER_URL above for a
# pure `manage.py runserver`, no-Docker setup.
# Do NOT set this in staging/production - see apps/writing/README.md.
WRITING_EAGER_MODE=1
